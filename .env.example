NODE_ENV=development
# Google Gemini API key (server-side only)
GEMINI_API_KEY=
# Optional: path to the SQLite database (defaults to ./data/care4rare.db)
# DATABASE_PATH=
# Optional: initial passwords used by `yarn db:seed` (random passwords are generated and printed if unset)
# SEED_ADMIN_PASSWORD=
# SEED_CLINICIAN_PASSWORD=
